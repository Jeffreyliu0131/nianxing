# Browser-safe configuration. Keep this URL relative when the AI gateway is
# served from the same host as the PWA.
VITE_AI_ENDPOINT=/api/organize

# Server-only configuration. Never prefix the API key with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
PORT=8787
